# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Madras12!@
DB_NAME=aegis_np

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=7d

# Azure AD / Microsoft Graph
# For multi-tenant apps, use 'common' (any Azure AD tenant can sign in)
# For single-tenant apps, use your specific tenant ID
AZURE_AUTHORITY=common
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Microsoft 365 Connection Configuration
M365_CONNECTION_MODE=application
M365_CERTIFICATE_THUMBPRINT=
M365_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
M365_POWERSHELL_EXECUTION_MODE=process

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
STORAGE_PATH=./storage

# Email (Nodemailer)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=support_svc@velocyverse.com
SMTP_PASS=Cool@kal1
SMTP_FROM=support_svc@velocyverse.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000

# OAuth (for platform login)
GOOGLE_CLIENT_ID=your-google-client-id
MICROSOFT_CLIENT_ID=your-microsoft-client-id

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_ID_STARTER=price_your-starter-price-id
